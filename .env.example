# Vercel AI Gateway (branch T: TypeSafe Jev 1.13, free tier at run time).
# Create a key: Vercel dashboard > AI Gateway > API keys.
# The team must have a valid payment method on file to use AI Gateway.
AI_GATEWAY_API_KEY=...

# NVIDIA NIM trial key (embeddings + cross-encoder reranker).
