# Codiv (OpenJev System One endpoint). Free key: https://codiv.ai/signup
TYPESAFE_API_KEY=sk-codiv-...

# NVIDIA NIM trial key. Free key: https://build.nvidia.com/settings
NVIDIA_API_KEY=nvapi-...

# OpenRouter key for the real TypeSafe Jev 1.13 branch (paid, ~$0.04/1M input tokens).
# Requires credits: https://openrouter.ai/settings/credits
OPENROUTER_API_KEY=sk-or-v1-...

# Alternative route for branch T: Vercel AI Gateway (same price, no markup).
# Use with: openjev-rag --config configs/vercel.yaml add-branch ... --branch T
AI_GATEWAY_API_KEY=...
